{
  "name": "observatory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "data:local": "node --import tsx server/generateLocalRun.ts",
    "sim": "tsx src/cli.ts",
    "run-sim": "tsx --env-file-if-exists=.env src/run.ts",
    "dream": "tsx --env-file-if-exists=.env src/dream.ts",
    "viewer": "vite viewer",
    "fetch-graph": "tsx scripts/fetch-graph.ts",
    "lab": "tsx --env-file-if-exists=.env src/lab/loop.ts",
    "lab:scenarios": "tsx src/lab/make-scenarios.ts",
    "lab:demo": "tsx src/lab/demo.ts",
    "lab:read": "tsx src/lab/read.ts",
    "lab:report": "tsx src/lab/report.ts",
    "lab:moments": "tsx src/lab/moments.ts",
    "lab:attention": "tsx src/lab/attention.ts",
    "lab:ab": "LAB_DIR=lab/plan LAB_MOMENTS=lab/moments5.json tsx --env-file-if-exists=.env src/lab/ab.ts",
    "lab:micro": "LAB_DIR=lab/micro LAB_MOMENTS=lab/moments.json tsx --env-file-if-exists=.env src/lab/loop.ts --candidate-reps 1 --hypotheses 4 --min-gain 0.2 --max-harm 0.1 --parallel 40 --no-hand-written",
    "lab:micro:report": "LAB_DIR=lab/micro LAB_MOMENTS=lab/moments.json tsx src/lab/report.ts",
    "hr:sync": "tsx --env-file-if-exists=.env scripts/hr-sync-workflow.ts",
    "hr:phone": "tsx --env-file-if-exists=.env scripts/hr-phone-webhook.ts",
    "hr:generator": "tsx --env-file-if-exists=.env scripts/hr-fix-112-coordinator.ts",
    "hr:triage": "tsx --env-file-if-exists=.env scripts/hr-fix-112-triage.ts",
    "test": "node --import tsx --test tests/run-model.test.ts tests/engine-trace.test.ts tests/interventions.test.ts tests/situation.test.ts tests/tickets.test.ts tests/policies.test.ts",
    "test:engine": "vitest run",
    "test:ui": "playwright test",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@happyrobot-ai/sdk": "^0.1.50",
    "@huggingface/transformers": "^4.3.0",
    "d3-force": "^3.0.0",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.10.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/d3-force": "^3.0.10",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "tsx": "^4.23.13",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vitest": "^5.0.1"
  }
}
