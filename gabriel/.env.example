# HappyRobot coordinator (pnpm run-sim --coordinator happyrobot)
# Copy to .env and fill in. Never commit .env.
HAPPYROBOT_API_KEY=sk_live_...
HAPPYROBOT_CLUSTER=eu
HAPPYROBOT_WORKFLOW_ID=01a0b8f3-129a-723f-936b-ad3489c86960
HAPPYROBOT_NODE_ID=3a642fac-5364-4ca9-8873-2c47ad03fbad

# Dream workflow: reorganises the agent's memory after each session (pnpm dream, or the end of pnpm run-sim).
# Create it once in the HappyRobot UI (trigger + one AI node with structured output), then `pnpm hr:sync --dream`
# pushes the prompt and schema from src/memory/dream-protocol.ts. Without these two, the dream runs on Claude.
HAPPYROBOT_DREAM_WORKFLOW_ID=
HAPPYROBOT_DREAM_NODE_ID=
