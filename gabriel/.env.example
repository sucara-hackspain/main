# HappyRobot coordinator (pnpm run-sim --coordinator happyrobot)
# Copy to .env and fill in. Never commit .env.
HAPPYROBOT_API_KEY=sk_live_...
HAPPYROBOT_CLUSTER=eu
HAPPYROBOT_WORKFLOW_ID=01a0b8f3-129a-723f-936b-ad3489c86960
HAPPYROBOT_NODE_ID=3a642fac-5364-4ca9-8873-2c47ad03fbad

# Dream workflow: reorganises the agent's memory after each session (pnpm dream, or the end of pnpm run-sim).
# Create it once in the HappyRobot UI (trigger + one AI node with structured output), then `pnpm hr:sync --dream`
# pushes the prompt and schema from src/memory/dream-protocol.ts. Without these two, the dream runs on Claude.
HAPPYROBOT_DREAM_WORKFLOW_ID=
HAPPYROBOT_DREAM_NODE_ID=

# Agentic master (`--master happyrobot`): the `master` workflow and the persistent_id of its turn node.
# Push its prompt and schema with `pnpm hr:sync --master`.
HAPPYROBOT_MASTER_WORKFLOW_ID=
HAPPYROBOT_MASTER_NODE_ID=
# 112 calls worded by an agent (`--calls happyrobot`): the `sim-112` workflow and its output node.
HAPPYROBOT_CALLS_WORKFLOW_ID=
HAPPYROBOT_CALLS_NODE_ID=
# Where `sim-112` is published, if not in production.
HAPPYROBOT_CALLS_ENVIRONMENT=

# The real 112 line (`--phone`): the voice workflow that answers the number, and the persistent_id of the
# node that files the call record once the caller hangs up.
HAPPYROBOT_PHONE_WORKFLOW_ID=
HAPPYROBOT_PHONE_NODE_ID=
