OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=anthropic/claude-opus-5

# Agentes 112 en HappyRobot (sin clave, `step` va sin agentes; `--agents off` los apaga)
HAPPYROBOT_API_KEY=sk_live_...
HAPPYROBOT_BASE_URL=https://platform.eu.happyrobot.ai/api/v2
HAPPYROBOT_TIMEOUT_MS=90000
HAPPYROBOT_TRIAGE_WORKFLOW=01a0ba99-6f31-7fc8-a336-20eea7a1f42d      # 112-triage (debe estar publicado)
HAPPYROBOT_COORDINATOR_WORKFLOW=01a0bac2-283b-7174-8857-5ea031bf4cf5 # 112-coordinator
HAPPYROBOT_OUTBOUND_WORKFLOW=01a0ba28-1760-7bcc-8ba5-f6a7385db05b   # 112-outbound: seguimiento telefónico real a los rescatados
# COORDINATOR_EVERY_TURNS=5      cada cuántos turnos corre el coordinador 112
# FOLLOWUP_PRIORITIES=low        prioridades del tablón con seguimiento (p. ej. low,medium)
# FOLLOWUP_AFTER_TURNS=10        turnos tras el rescate antes de la llamada de seguimiento
# FOLLOWUP_SIMULATED=on          llamadas sin teléfono: seguimiento inventado por sim-112-outbound (off = solo llamadas reales)
# PHONE_PORT=8112                `npm run phone`: POST /phone y /followup para los workflows de voz
# PUBLIC_URL=https://xxxx.ngrok-free.dev   túnel al puerto anterior; `npm run webhooks` apunta ahí los nodos POST
